# ==============================================================================
# SISTEMA DE BORRADORES DE ESCRITURAS PÚBLICAS - CONFIGURACIÓN LOCAL
# ==============================================================================

# Entorno: development | production | testing
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Sistema de Borradores de Escrituras Públicas"
VERSION="1.0.0"
API_V1_STR=/api/v1

# Servidor Backend
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Base de Datos (SQLite Local)
# Vacío utiliza la ruta absoluta backend/app.db.
# Para otra base, preferir una URI absoluta: sqlite:///D:/datos/notariado/app.db
DATABASE_URL=

# Seguridad y Autenticación (Cambiar en despliegue)
# setup.ps1 sustituye este valor por una clave local aleatoria al crear .env.
SECRET_KEY=GENERATE_LOCAL_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rutas de Almacenamiento Local
# Al omitirlas, se utilizan backend/uploads y backend/generated absolutos.
# Los scripts operativos ejecutan Python desde backend. Las rutas relativas
# configuradas explícitamente se resuelven desde esa carpeta.
# UPLOAD_DIR=./uploads
# GENERATED_DIR=./generated

# Parámetros Experimentales de Tesis
DEFAULT_BASELINE_MINUTES=240
TARGET_MINUTES=60
TOTAL_SYNTHETIC_CASES=100
